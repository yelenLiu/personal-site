---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---
<Base title="Projects"><div class="page"><h1>Projects<span class="mark">.</span></h1><p class="pageintro">Small tools, working experiments, and unfinished ideas. I distinguish public releases from work in progress.</p>{projects.map(project => <div class="entry project"><div><h3>{project.url ? <a href={project.url}>{project.name} ↗</a> : project.name}</h3><p>{project.description}</p></div><span class="pill">{project.tag}</span></div>)}</div></Base>