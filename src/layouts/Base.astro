---
interface Props { title: string; description?: string; path?: string; articleDate?: string; noindex?: boolean; }
const { title, description = 'Notes on AI agents, developer tools, and building independent software.', path, articleDate, noindex = false } = Astro.props;
const origin = Astro.site!;
const pathname = path || Astro.url.pathname;
const canonical = new URL(pathname.endsWith('/') ? pathname : `${pathname}/`, origin).toString();
const siteTitle = title === 'Home' ? 'Yelen — Building with AI' : `${title} | Yelen`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Yelen Writing" href="/rss.xml" />
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:site_name" content="Yelen" />
    {articleDate && <meta property="article:published_time" content={new Date(articleDate).toISOString()} />}
    {articleDate && <meta property="article:author" content="Yelen" />}
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{siteTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="shell">
      <header class="header">
        <a href="/" class="wordmark" aria-label="Yelen home">Yelen<span class="mark">.</span></a>
        <nav aria-label="Main navigation">
          {['Writing', 'Projects', 'About'].map(label => {
            const href = `/${label.toLowerCase()}/`;
            return <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>;
          })}
        </nav>
      </header>
      <main id="main-content" tabindex="-1"><slot /></main>
      <footer class="footer"><span>© {new Date().getFullYear()} Yelen</span><div><button id="theme-toggle" type="button" aria-label="Color theme: system. Activate to switch to light.">Theme: system</button><a href="https://github.com/yelenLiu" rel="me">GitHub</a><a href="https://x.com/yelen480820" rel="me">X</a><a href="/rss.xml">RSS</a></div></footer>
    </div>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const themes = ['system', 'light', 'dark'] as const;
      let theme = document.documentElement.dataset.theme || 'system';
      const update = () => {
        if (!button) return;
        const next = themes[(themes.indexOf(theme as typeof themes[number]) + 1) % themes.length];
        button.textContent = `Theme: ${theme}`;
        button.setAttribute('aria-label', `Color theme: ${theme}. Activate to switch to ${next}.`);
      };
      update();
      button?.addEventListener('click', () => {
        theme = themes[(themes.indexOf(theme as typeof themes[number]) + 1) % themes.length];
        if (theme === 'system') delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = theme;
        try {
          if (theme === 'system') localStorage.removeItem('theme');
          else localStorage.setItem('theme', theme);
        } catch {}
        update();
      });
    </script>
  </body>
</html>